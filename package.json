{
  "name": "tamki",
  "version": "0.1.0",
  "private": true,
  "description": "A Chromium browser and a video library across your own storage.",
  "author": "CNJ-Devs",
  "license": "MIT",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "check": "tsc --noEmit && npm run build",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "npm run build && node tests/browser.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "format": "prettier --write src scripts tests README*.md CONTRIBUTING.md AGENTS.md package.json tsconfig.json .github/workflows/ci.yml"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "45.3.1",
    "esbuild": "^0.25.0",
    "playwright": "^1.58.0",
    "prettier": "3.10.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "glob": "14.0.6",
    "minimatch": "11.0.8"
  }
}
