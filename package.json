{
  "name": "tamki",
  "version": "0.1.0",
  "private": true,
  "description": "A Chromium browser foundation for a video library across your own storage.",
  "author": "CNJ-Devs",
  "license": "MIT",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "check": "tsc --noEmit && npm run build",
    "test": "node --import tsx --test tests/navigation.test.ts",
    "test:browser": "npm run build && node tests/browser.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "format": "prettier --write src scripts tests README*.md CONTRIBUTING.md AGENTS.md package.json tsconfig.json .github/workflows/ci.yml"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "^22.20.5",
    "electron": "45.3.1",
    "esbuild": "^0.25.0",
    "playwright": "^1.58.0",
    "prettier": "3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "glob": "14.0.6",
    "minimatch": "11.0.8"
  }
}
